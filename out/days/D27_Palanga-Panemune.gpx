  <metadata>
    <name>D27 Palanga → Panemunė Castle</name>
    <desc>215 km road, ≈3.9 h riding. LWH stayed in a Lithuanian castle and took a balloon flight – castle unconfirmed. Balloon flights operate around Kaunas/Trakai.</desc>
  </metadata>
  <wpt lat="55.297" lon="21.374">
    <name>Rusnė (Nemunas delta)</name>
    <desc>D27 · spur: dead-end · Optional island village in the Nemunas delta, out and back</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="55.09926" lon="22.98642">
    <name>Panemunė Castle</name>
    <desc>D27 · Castle hotel – suggested match for LWH's Lithuanian castle, unconfirmed</desc>
