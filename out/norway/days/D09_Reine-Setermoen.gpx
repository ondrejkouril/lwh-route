  <metadata>
    <name>D09 Reine → Lofoten → Lofast → Setermoen</name>
    <desc>387 km road, ≈7.1 h riding.</desc>
  </metadata>
  <wpt lat="68.03541" lon="13.3477">
    <name>Nusfjord</name>
    <desc>D09 · Preserved fishing village, 4 km off the E10 (dead end)</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="68.24423" lon="13.75695">
    <name>Lofotr Viking Museum</name>
    <desc>D09 · Reconstructed Viking chieftain's longhouse at Borg, beside the E10</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="68.15" lon="14.2">
    <name>Henningsvær</name>
    <desc>D09 · Fishing village on skerries, ≈ 25 km out and back on Fv816 – only if there is time</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="68.23116" lon="14.56482">
    <name>Lofoten War Memorial Museum</name>
    <desc>D09 · Military: WWII collection (Operation Claymore raid, uniforms, Tirpitz relics) in Svolvær</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="68.43778" lon="17.42537">
    <name>Narvik War Museum</name>
    <desc>D09 · Military: the 1940 battles of Narvik, 13 km south of Bjerkvik on the E6</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="68.86094" lon="18.34824">
    <name>Setermoen</name>
    <desc>D09 · Campsite cabin</desc>
    <sym>Campground</sym>
    <type>overnight</type>
  </wpt>
