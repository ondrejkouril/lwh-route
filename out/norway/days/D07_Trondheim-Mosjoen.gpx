  <wpt lat="63.79546" lon="11.56022">
    <name>Stiklestad</name>
    <desc>D07 · Viking: where King Olav Haraldsson (St Olav) fell in 1030 – culture centre and open-air museum, 5 km off the E6 at Verdal</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="65.62384" lon="13.29164">
    <name>Laksforsen</name>
    <desc>D07 · 17 m waterfall beside the E6, with a café over the falls</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="65.83753" lon="13.18921">
    <name>Mosjøen</name>
    <desc>D07 · Campsite cabin. Sjøgata: a street of 19th-century wooden wharf houses</desc>
    <sym>Campground</sym>
    <type>overnight</type>
  </wpt>
