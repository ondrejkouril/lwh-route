  <wpt lat="59.27327" lon="14.05161">
    <name>Picasso sculpture</name>
    <desc>D26 · 15 m concrete Picasso head on the Vänern shore at Kristinehamn</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="59.34141" lon="14.53481">
    <name>Bofors Industrimuseum</name>
    <desc>D26 · Military: the Bofors gun works and Alfred Nobel's Björkborn manor in Karlskoga, ≈ 25 km east of Kristinehamn</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="58.5807" lon="14.43506">
    <name>Forsvik</name>
