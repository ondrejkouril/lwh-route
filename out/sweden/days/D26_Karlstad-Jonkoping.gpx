    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="58.52859" lon="14.52703">
    <name>Karlsborg Fortress</name>
    <desc>D26 · Military: huge 19th-century fortress built as Sweden's reserve capital, with the Karlsborg fortress museum</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
