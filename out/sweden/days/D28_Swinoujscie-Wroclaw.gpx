  <metadata>
    <name>D28 Świnoujście → Międzyrzecz bunkers → Wrocław</name>
    <desc>482 km road, ≈5.0 h riding.</desc>
  </metadata>
  <wpt lat="52.37196" lon="15.5058">
    <name>Międzyrzecz Fortified Region</name>
    <desc>D28 · Military: Międzyrzecki Rejon Umocniony – 1930s German bunker line; underground tours 1.5 h (short) or 2.5 h (long, to the underground railway station). Check times and book ahead</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="51.1101" lon="17.0444">
    <name>Racławice Panorama</name>
    <desc>D28 · Military: 114 m panorama painting of the 1794 Battle of Racławice, in Wrocław</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="51.04" lon="16.97">
    <name>Wrocław</name>
    <desc>D28 · Hotel by the A4/A8 junction (Bielany Wrocławskie), away from the city traffic</desc>
    <sym>Lodging</sym>
    <type>overnight</type>
  </wpt>
  <rte>
    <name>D28 Świnoujście ferry terminal → Wrocław</name>
    <desc>Świnoujście → Międzyrzecz bunkers → Wrocław</desc>
