  <metadata>
    <name>D27 Jönköping → Växjö → Ales stenar → Ystad ⛴</name>
    <desc>384 km road, ≈5.4 h riding.</desc>
  </metadata>
  <wpt lat="56.94191" lon="14.79436">
    <name>Kronoberg Castle ruin</name>
    <desc>D27 · Medieval castle ruin on an island in Lake Helgasjön, 6 km north of Växjö</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="56.87557" lon="14.80883">
    <name>Utvandrarnas hus</name>
    <desc>D27 · House of Emigrants: the 1.3 million Swedes who left for America, in Växjö</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="55.3826" lon="14.0545">
    <name>Ales stenar</name>
    <desc>D27 · Viking: 67 m stone ship of 59 boulders on the cliff above Kåseberga</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="55.5011" lon="14.2306">
    <name>Glimmingehus</name>
    <desc>D27 · Best-preserved medieval castle in Scandinavia (1499), 15 km north-east of Kåseberga</desc>
    <sym>Scenic Area</sym>
    <type>poi</type>
  </wpt>
  <wpt lat="55.4285" lon="13.8262">
    <name>Ystad ferry terminal</name>
    <desc>D27 · Night ferry to Świnoujście (Polferries or Unity Line), ≈ 22:00–23:00 → 06:00–07:00; book a cabin</desc>
    <sym>Anchor</sym>
    <type>ferry_start</type>
  </wpt>
  <wpt lat="53.9097" lon="14.2683">
    <name>Świnoujście ferry terminal</name>
    <desc>D27</desc>
    <sym>Anchor</sym>
    <type>ferry_end</type>
  </wpt>
  <wpt lat="53.9097" lon="14.2683">
    <name>Cabin on board, arriving ≈ 06:00–07:00</name>
    <desc>D27 · Cabin on the night ferry; you wake up in Świnoujście</desc>
    <sym>Lodging</sym>
    <type>overnight</type>
  </wpt>
